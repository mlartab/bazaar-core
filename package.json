{
  "name": "bazaar-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" \"test/protocol/*.test.mjs\"",
    "test:fast": "node --test \"test/*.test.mjs\" \"test/protocol/*.test.mjs\" --test-name-pattern='^(?!.*stream|.*events feed)'",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:protocol": "node --test \"test/protocol/*.test.mjs\"",
    "start": "node protocol/start.js",
    "dev": "node protocol/start.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "viem": "^2.57.14"
  }
}
