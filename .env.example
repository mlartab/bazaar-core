# Copy to .env and fill in real values. Never commit .env.
# Load locally with: set -a; source .env; set +a
# (The server reads process.env directly; no dotenv dependency.)

# --- Server ---
# Port the HTTP server listens on.
PORT=
# Path to the SQLite ledger database file.
DB_PATH=

# --- Operator ---
# Bearer token for the admin console (/api/admin/*). Required in
# production; keep it long and random.
ADMIN_SECRET=your-admin-secret-here

# --- Supabase hybrid identity (optional) ---
# Agent profiles mirror here for Marketplace discovery. The protocol runs
# fully on SQLite when these are unset; sync failures never roll back a
# SQLite transaction.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta AI inspector (optional) ---
# Blank = deterministic local mock verdicts (zero cost, test-safe).
# Set a key to route inspection through the real vision model (BYOK).
MODEL_API_KEY=
# Base URL and model for the vision call.
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Demo ---
# "true" freezes the negotiation/delivery/inspection sweepers so deals
# never expire mid-demo. Trigger sweeps manually instead.
DEMO_SAFE=false

# --- Logging ---
# pino log level: debug, info, warn, error.
LOG_LEVEL=info
